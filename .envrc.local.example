# shellcheck shell=bash
# Copy this file to .envrc.local and fill in your own token — a
# fine-grained PAT with Contents/Pull requests/Actions/Issues read-write,
# NOT Administration. (Secrets/Variables: Read-only is no longer needed:
# no github_actions_secret or _variable resource is left for a plan to
# refresh.) Use `env -u GH_TOKEN -u GITHUB_TOKEN gh ...` for anything that
# needs the full-admin session instead (both vars, since .envrc aliases
# GITHUB_TOKEN to this same scoped token and gh prefers it) — e.g. the
# branch-protection bootstrap script.
export GH_TOKEN=

# The state passphrase and R2 read/write backend credentials are NOT here
# (#59/ADR-0009, store moved to SSM by #126/ADR-0010) — they live in
# /infra/* SSM parameters and are fetched at invocation, gated behind the
# macOS Keychain, by scripts/with-infra-secrets.sh. So always run tofu via
# `just tofu` / `just tofu-apply`, never bare, and expect a Keychain
# "Allow" prompt.
#
# One-time setup — store the infra-local-apply IAM user's access key in
# the login Keychain WITHOUT an app ACL, so every read prompts (that's the
# gate). The key id rides the account attribute, the secret is the
# password (docs/BOOTSTRAP.md has the key-creation console step):
#     security add-generic-password -s infra-aws-local-apply -a <ACCESS_KEY_ID> -w
#   (paste the secret access key at the prompt; omitting -A is deliberate.)
# Rotate the Keychain item by re-running the command above with -U.

# Cloudflare provider (#7, epic #6) — a least-privilege API token the
# `cloudflare` provider reads directly, for managing the R2 state bucket
# (#8) and DNS (#9, first resources wired here). Create it at Cloudflare
# dashboard → My Profile → API Tokens → Create Token (custom): Zone → Zone
# → Read, Zone → DNS → Edit, Account → Workers R2 Storage → Edit; scope
# Zone Resources to the managed zones. This is a Cloudflare API *bearer*
# token, distinct from the R2 *S3* credentials the state backend uses
# (those are Keychain-fetched now).
export CLOUDFLARE_API_TOKEN=

# Cloudflare account id that filmitinc.com and leppez.com's zones (#9)
# belong to — not secret, but an account identifier, so it's env-sourced
# like every other one here rather than a literal in dns.tf.
export TF_VAR_cloudflare_account_id=
