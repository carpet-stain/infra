# shellcheck shell=bash
# Copy this file to .envrc.local and fill in the values below as each
# module's bootstrap reaches the point that needs them.
# No GitHub token lives here (#151): the routine dev PAT — fine-grained,
# Contents/Pull requests/Actions/Issues read-write, NOT Administration —
# is gh's default keyring credential (`gh auth login --with-token`), and
# .envrc derives GH_TOKEN/GITHUB_TOKEN from it. Anything that needs
# Administration rides the SSM-gated admin token instead (ADR-0013):
# `scripts/with-infra-secrets.sh --gh-admin env -u GH_TOKEN <cmd>` — drop
# GH_TOKEN since gh prefers it over the GITHUB_TOKEN the wrapper exports —
# e.g. the branch-protection bootstrap script.

# The state passphrase and R2 read/write backend credentials are NOT here
# (#59/ADR-0009, store moved to SSM by #126/ADR-0010) — they live in
# /infra/* SSM parameters and are fetched at invocation, gated behind the
# macOS Keychain, by scripts/with-infra-secrets.sh. So always run tofu via
# `just tofu` / `just tofu-apply`, never bare, and expect a Keychain
# "Allow" prompt.
#
# One-time setup — store the infra-local-apply IAM user's access key in
# the login Keychain WITHOUT an app ACL, so every read prompts (that's the
# gate). The key id rides the account attribute, the secret is the
# password (docs/BOOTSTRAP.md has the key-creation console step):
#     security add-generic-password -s infra-aws-local-apply -a <ACCESS_KEY_ID> -w
#   (paste the secret access key at the prompt; omitting -A is deliberate.)
# Rotate the Keychain item by re-running the command above with -U.

# All values below are non-secret but account-identifying, so they stay
# out of this public repo's committed .tf files the same way
# cloudflare_account_id always has (ADR-0002) — env-sourced, never a
# literal. Grouped by which module's `variable` block reads them.

# ==== Root module (main.tf, applied via `just tofu`/`just tofu-apply`) =====

# filmitinc.com and leppez.com's zones (#9) belong to this Cloudflare account.
export TF_VAR_cloudflare_account_id=

# The agent-memory edge invoker (ADR-0031, #323) — the Worker-minted-ID-
# token fence replacing ADR-0026's never-built allUsers path. Left blank
# until the consumer's first deploy names both (docs/BOOTSTRAP.md §20).
export TF_VAR_agent_memory_edge_origin_url=

# ==== iam/ module (iam/main.tf, applied via `just tofu-iam`) ===============

# Numeric unique_ids read after gcp/'s apply creates each SA (docs/BOOTSTRAP.md
# §17/§18's chicken-and-egg ordering) — left blank until then. Adding a new
# GCP→AWS federation consumer's own *_service_account_unique_id var? Add its
# export here in the same change (§17's add-a-consumer note, #257) —
# `just tofu-iam apply` now fails loud on one that's missing, but only once
# the export exists to fill in.
export TF_VAR_gcp_dispatch_service_account_unique_id=
export TF_VAR_gcp_agent_memory_service_account_unique_id=

# AWS Budgets notification address (#233, epic #230).
export TF_VAR_aws_budget_notification_email=

# ==== gcp/ module (gcp/main.tf, applied via `just tofu-gcp`) ===============

# GCP project hosting the vend-token dispatch job (ADR-0024, #191) and every
# other gcp/ resource. `google_region` defaults to us-central1 if left unset.
# GOOGLE_APPLICATION_CREDENTIALS isn't set here — auth rides
# `gcloud auth application-default login` (docs/BOOTSTRAP.md §17).
export TF_VAR_google_project_id=
export TF_VAR_google_region=

# GCP Billing Budgets (#276, epic #230).
export TF_VAR_gcp_billing_account_id=
export TF_VAR_gcp_budget_notification_email=

# iam/'s dispatch_read_role_arn output and the built dispatch image ref —
# both resolved only after iam/'s apply and the manual image push
# (docs/BOOTSTRAP.md §17's chicken-and-egg ordering), left blank until then.
export TF_VAR_aws_dispatch_role_arn=
export TF_VAR_dispatch_image=

# The agent-memory bootstrap seam (ADR-0026, #240) — the deploy sub is built
# from agent-memory-server's repo id; the plan-read sub is its pull_request
# twin, a distinct WIF provider so a PR job can never present the apply-only
# sub (#272); the Service name is the consumer's own agent-memory-<role>
# shape. Left blank until each exists (docs/BOOTSTRAP.md §18/§19).
export TF_VAR_agent_memory_deploy_sub=
export TF_VAR_agent_memory_plan_read_sub=
export TF_VAR_agent_memory_service_name=
